[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "{{ org.package_name }}"
version = "1.0.0"
description = "{{ org.description }}"
requires-python = ">=3.12, <3.14"
dependencies = [
    "agentorg",
    "agentfield>=0.1.84",
    "agno>=2.0",
    "fastapi[standard]",
    "google-genai>=2.2.0,<2.9.0",
]

[dependency-groups]
dev = ["pytest>=8", "pytest-asyncio>=0.23", "httpx>=0.27"]

[tool.hatch.build.targets.wheel]
packages = ["src/{{ org.package_name }}"]

[tool.pytest.ini_options]
asyncio_mode = "auto"
