{% set featured = ui.featured_agents[0] if ui.featured_agents else (ai.agents[0].id if ai.agents else ai.root) %}
# LibreChat configuration for {{ org.name }}, generated by agentorg from spec.py. Re-render instead of editing.
version: 1.3.13

interface:
  customWelcome: {{ (ui.empty_state.title ~ ' Runs, approvals and settings: http://localhost:5173') | tojson }}
  modelSelect: false
  parameters: false
  presets: false
  prompts: false
  agents: false
  mcpServers:
    use: false
    create: false
  memories: false
  fileSearch: false
  fileCitations: false
  runCode: false
  webSearch: false
  marketplace:
    use: false

endpoints:
  custom:
    - name: {{ org.name | tojson }}
      apiKey: '${CHAT_API_KEY}'
      baseURL: '${AGENTORG_CHAT_URL}'
      models:
        default:
{% for agent in ai.agents %}
          - {{ agent.id | tojson }}
{% endfor %}
{% for unit in ai.units %}
          - {{ unit.id | tojson }}
{% endfor %}
        fetch: false
      titleConvo: false
      modelDisplayLabel: {{ ui.app.name | tojson }}
      dropParams: ['stop', 'user', 'frequency_penalty', 'presence_penalty', 'temperature', 'top_p']
      headers:
        X-Agentorg-User-Id: '{{ '{{' }}LIBRECHAT_USER_ID{{ '}}' }}'
        X-Agentorg-User-Email: '{{ '{{' }}LIBRECHAT_USER_EMAIL{{ '}}' }}'
        X-Agentorg-Conversation-Id: '{{ '{{' }}LIBRECHAT_BODY_CONVERSATIONID{{ '}}' }}'

modelSpecs:
  enforce: true
  prioritize: true
  list:
{% for agent in ai.agents %}
{% set icon = ui.agent_icons.get(agent.id, '') %}
{% set config = ui.agent_configs.get(agent.id) %}
    - name: {{ agent.id | tojson }}
      label: {{ (((icon ~ ' ') if icon else '') ~ agent.name) | tojson }}
      description: {{ (config.description if config and config.description else agent.role) | tojson }}
      group: 'Agents'
      default: {{ 'true' if agent.id == featured else 'false' }}
{% if ui.chat_quick_prompts.get(agent.id) %}
      conversation_starters: {{ ui.chat_quick_prompts[agent.id][:4] | tojson }}
{% endif %}
      preset:
        endpoint: {{ org.name | tojson }}
        model: {{ agent.id | tojson }}
        modelLabel: {{ agent.name | tojson }}
{% endfor %}
{% for unit in ai.units %}
    - name: {{ unit.id | tojson }}
      label: {{ unit.name | tojson }}
      description: {{ ('A ' ~ unit.model ~ ' unit of ' ~ (unit.members | join(', ')) ~ '.') | tojson }}
      group: 'Units'
      default: {{ 'true' if unit.id == featured else 'false' }}
      preset:
        endpoint: {{ org.name | tojson }}
        model: {{ unit.id | tojson }}
        modelLabel: {{ unit.name | tojson }}
{% endfor %}
