services:
  control-plane:
    image: agentfield/control-plane:latest
    container_name: {{ org.slug }}-control-plane
    restart: unless-stopped
    ports:
      - "8080:8080"
    environment:
      AGENTFIELD_HTTP_ADDR: 0.0.0.0:8080
      AGENTFIELD_STORAGE_MODE: local
    volumes:
      - agentfield-data:/data
    networks:
      - {{ org.slug }}

  rabbitmq:
    image: rabbitmq:3.13-management
    container_name: {{ org.slug }}-rabbitmq
    restart: unless-stopped
    ports:
      - "5672:5672"
      - "15672:15672"
    volumes:
      - rabbitmq-data:/var/lib/rabbitmq
    networks:
      - {{ org.slug }}
    healthcheck:
      test: ["CMD", "rabbitmq-diagnostics", "-q", "ping"]
      interval: 5s
      retries: 20

  {{ org.slug }}-db:
    image: pgvector/pgvector:pg17
    container_name: {{ org.slug }}-db
    restart: unless-stopped
    environment:
      POSTGRES_USER: ${DB_USER:-ai}
      POSTGRES_PASSWORD: ${DB_PASS:-ai}
      POSTGRES_DB: ${DB_DATABASE:-ai}
    volumes:
      - pgdata:/var/lib/postgresql
    ports:
      - "5432:5432"
    networks:
      - {{ org.slug }}
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${DB_USER:-ai}"]
      interval: 5s
      retries: 10

  {{ org.slug }}-api:
    build:
      context: .
      dockerfile: Dockerfile
    image: ${IMAGE_NAME:-{{ org.slug }}}:${IMAGE_TAG:-latest}
    container_name: {{ org.slug }}-api
    command: uvicorn {{ org.package_name }}.app.main:app --host 0.0.0.0 --port 8000 --reload
    restart: unless-stopped
    ports:
      - "8000:8000"
    volumes:
      - .:/app
    environment:
      - RUNTIME_ENV=dev
      - RESET_ON_STARTUP=1
      - AGENTFIELD_SERVER=http://control-plane:8080
      - NODE_ID={{ org.slug }}
      - AGENT_CALLBACK_URL=http://{{ org.slug }}-api:8000
      - DB_HOST={{ org.slug }}-db
      - DB_PORT=5432
      - DB_USER=${DB_USER:-ai}
      - DB_PASS=${DB_PASS:-ai}
      - DB_DATABASE=${DB_DATABASE:-ai}
{% if runtime.infra.database == 'postgres' %}      - DATABASE_URL=postgresql://${DB_USER:-ai}:${DB_PASS:-ai}@{{ org.slug }}-db:5432/${DB_DATABASE:-ai}
{% endif %}{% for v in runtime.env_vars.required %}{% if v.name == 'AMQP_URL' %}      - AMQP_URL=${AMQP_URL:-amqp://guest:guest@rabbitmq:5672/}
{% else %}      - {{ v.name }}=${{ '{' }}{{ v.name }}{{ '}' }}
{% endif %}{% endfor %}{% for v in runtime.env_vars.optional %}      - {{ v.name }}=${{ '{' }}{{ v.name }}:-{{ '}' }}
{% endfor %}    depends_on:
      control-plane:
        condition: service_started
      {{ org.slug }}-db:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
    networks:
      - {{ org.slug }}
    extra_hosts:
      - "host.docker.internal:host-gateway"

  {{ org.slug }}-ui:
    image: node:20-alpine
    container_name: {{ org.slug }}-ui
    working_dir: /app/src/frontend
    command: sh -c "npm ci --ignore-scripts && npm run dev -- --host"
    restart: unless-stopped
    ports:
      - "5173:5173"
    volumes:
      - .:/app
    environment:
      - VITE_API_HOST=http://{{ org.slug }}-api:8000
    depends_on:
      - {{ org.slug }}-api
    networks:
      - {{ org.slug }}

networks:
  {{ org.slug }}:

volumes:
  pgdata:
  agentfield-data:
  rabbitmq-data:
