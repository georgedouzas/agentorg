"""FastAPI router for the rendered org's agentorg-specific endpoints."""

import asyncio
import contextlib
import json
import os
from datetime import UTC, datetime
from typing import Any

from fastapi import APIRouter, HTTPException, Query, Request, WebSocket, WebSocketDisconnect
from pydantic import BaseModel, Field, create_model
from sse_starlette.sse import EventSourceResponse

from agentorg.core.agents.tools import PREFIX as _KN_PREFIX, similarity_units
from agentorg.core.operations import TERMINAL, OrgRuntime, Run, broker_health
from agentorg.core.spec import Agent, Spec, Unit

_MASTER_AGENT_ID = 'master'
_STREAM_POLL_S = 0.3


class _Safe(dict):
    """`dict` that returns `{key}` for missing keys so principle bodies survive incomplete state."""

    def __missing__(self, key: str) -> str:
        return '{' + key + '}'


def _py_type(t: str) -> type:
    return {'int': int, 'float': float, 'string': str, 'bool': bool, 'object': dict, 'array': list}.get(t, str)


def _parameters_model(spec: Spec) -> type[BaseModel]:
    fields: dict[str, Any] = {}
    for p in spec.parameters:
        py = _py_type(p.type)
        fields[p.name] = (py, Field(default=p.default))
    return create_model('OrgParameters', **fields)  # type: ignore[call-overload]


def _document(unit: dict[str, Any]) -> dict[str, Any]:
    """Project a stored knowledge unit into the shape the frontend expects."""
    return {
        'type': unit.get('type'),
        'name': unit.get('name'),
        'title': unit.get('title'),
        'content': unit.get('content'),
        'metadata': unit.get('metadata') or {},
        'created_at': unit.get('updated_at'),
    }


def _triggers_of(spec: Spec, target: str) -> list[dict[str, Any]]:
    return [trigger.model_dump() for trigger in spec.operations.triggers if trigger.target == target]


def _agent_summary(spec: Spec, agent: Agent) -> dict[str, Any]:
    """Project an agent definition into the shape the dashboard's AgentPanel shows."""
    tools = list(agent.builtin_tools or []) + [fn.__name__ for fn in agent.tools]
    return {
        'id': agent.id,
        'name': agent.name,
        'role': agent.role,
        'model': agent.model,
        'autonomy': agent.autonomy,
        'persona': agent.persona.model_dump(),
        'tools': tools,
        'mcp_servers': [server.name for server in agent.mcp_servers],
        'skills': agent.skills,
        'replicas': agent.replicas,
        'instructions': agent.persona.instructions,
        'unit_path': [unit.id for unit in spec.ai.path_to(agent.id)],
        'triggers': _triggers_of(spec, agent.id),
        'is_platform': False,
    }


def _unit_summary(spec: Spec, unit: Unit) -> dict[str, Any]:
    members = [member if isinstance(member, str) else member.id for member in unit.member_refs]
    return {
        'id': unit.id,
        'name': unit.name,
        'model': unit.model,
        'lead': unit.lead,
        'members': members,
        'routing': unit.routing if unit.model == 'pool' else None,
        'decision': unit.decision,
        'triggers': _triggers_of(spec, unit.id),
    }


def _run_summary(run: Run) -> dict[str, Any]:
    return {
        'id': run.id,
        'target': run.target,
        'trigger_kind': run.trigger_kind,
        'trigger_id': run.trigger_id,
        'parent_id': run.parent_id,
        'status': run.status,
        'failure_reason': run.failure_reason,
        'output': run.output,
        'cost_usd': run.cost_usd,
        'input_tokens': run.input_tokens,
        'output_tokens': run.output_tokens,
        'created_at': run.created_at.isoformat() if run.created_at else None,
        'ended_at': run.ended_at.isoformat() if run.ended_at else None,
    }


class Decision(BaseModel):
    """A human decision on an approval."""

    approved: bool
    actor: str
    comment: str = ''
    edited_arguments: dict[str, Any] | None = None


class Transition(BaseModel):
    """A requested lifecycle transition."""

    to: str
    actor: str
    reason: str


class Enabled(BaseModel):
    """Whether an agent or unit takes new work."""

    enabled: bool
    actor: str


def build_router(app: Any, spec: Spec, runtime: OrgRuntime) -> APIRouter:  # noqa: C901
    """Build the FastAPI router with handlers closed over the AgentField node, the spec and the operations runtime."""
    router = APIRouter(prefix='/api/v1', tags=['api'])
    org_parameters = _parameters_model(spec)
    # AgentField exposes `app.memory` only inside reasoner executions; HTTP handlers run outside
    # any execution context, so capture the interface once at build time and reuse it.
    memory = app.memory
    knowledge = memory.global_scope

    targets = {agent.id for agent in spec.ai.agents} | {unit.id for unit in spec.ai.units}

    async def _all_units() -> list[dict[str, Any]]:
        # In preview mode the control plane is absent, so `list_keys` raises a memory
        # connection error. Treat that as "no knowledge yet" and return an empty list
        # so the Knowledge tab shows its empty state instead of a 500.
        try:
            keys = [k for k in await knowledge.list_keys() if k.startswith(_KN_PREFIX)]
        except Exception:
            return []
        units = []
        for k in keys:
            try:
                u = await knowledge.get(k)
            except Exception:
                continue
            if u is not None:
                units.append(u)
        return units

    # Seed placeholder strings the master agent has not yet replaced. The dashboard
    # uses this to detect "not configured yet" and render a getting-started state
    # instead of showing seed text as if it were the user's real content.
    _PLACEHOLDER_TEXTS = {
        'Not set yet', 'Untitled org', 'untitled-org', 'untitled_org', 'you@example.com',
        '🛠', 'You', 'A new agent organisation in progress.',
        'Nothing here yet', 'Your org is taking shape — keep chatting with AgentOrg.',
        '✨', 'No knowledge entries yet.',
        'TODO', 'My Org', 'my-org', 'my_org', 'author@example.com', 'robot',
    }

    # ── Config ──────────────────────────────────────────────────────────────
    @router.get('/config')
    def ui_config() -> dict[str, Any]:
        ui = spec.ui
        principles = spec.knowledge.principles
        defaults = {p.name: p.default for p in spec.parameters}
        sections = [
            {'id': s.id, 'title': s.title, 'body': s.body.format_map(_Safe(defaults))}
            for s in principles.sections
        ]
        return {
            'app_name': ui.app.name,
            'app_icon': ui.app.icon,
            'app_description': ui.app.description,
            'name_is_placeholder': ui.app.name in _PLACEHOLDER_TEXTS,
            'description_is_placeholder': ui.app.description in _PLACEHOLDER_TEXTS,
            'empty_state': ui.empty_state.model_dump(),
            'knowledge_empty': ui.knowledge_empty,
            'agent_groups': [g.model_dump() for g in ui.agent_groups],
            'workflow_groups': [g.model_dump() for g in ui.workflow_groups],
            'featured_agents': ui.featured_agents,
            'agent_icons': {_MASTER_AGENT_ID: '🛠', **ui.agent_icons},
            'units': [_unit_summary(spec, unit) for unit in spec.ai.units],
            'overview': [b.model_dump() for b in ui.overview],
            'agent_configs': {k: v.model_dump() for k, v in ui.agent_configs.items()},
            'parameters': [p.model_dump() for p in spec.parameters],
            'principles': {'sections': sections},
            # Synthesize a 'principle' knowledge type when there ARE sections, so the
            # React Knowledge view can bucket them like any other knowledge entries.
            'types': (
                [t.model_dump() for t in spec.knowledge.types]
                + ([{'id': 'principle', 'label': 'Principles', 'metadata_fields': []}] if sections else [])
            ),
            # The master agent is the one platform-level agent in the deployed org.
            # The Knowledge tab's author filter always lists it.
            'platform_agents': [{'id': _MASTER_AGENT_ID, 'name': 'Master'}],
            # Principles owner - the master owns them in the deployed org.
            'principles_owner': _MASTER_AGENT_ID,
        }

    # ── Org instance parameters ─────────────────────────────────────────────
    @router.get('/parameters')
    async def get_parameters() -> dict[str, Any]:
        # In preview mode the control plane is absent; treat that as 'no parameters set'.
        try:
            state = await knowledge.get('org_parameters')
        except Exception:
            return {'parameters': {}}
        return {'parameters': state.get('parameters', {}) if state else {}}

    @router.post('/parameters')
    async def set_parameters(body: org_parameters) -> dict[str, Any]:  # type: ignore[valid-type]
        params = {**body.model_dump(), 'inception_date': datetime.now(tz=UTC).date().isoformat()}
        await knowledge.set('org_parameters', {'parameters': params})
        return {'status': 'configured', 'parameters': params}

    @router.post('/parameters/reset')
    async def reset_parameters() -> dict[str, Any]:
        for key in [k for k in await knowledge.list_keys() if k.startswith(_KN_PREFIX)]:
            await knowledge.delete(key)
        await knowledge.delete('org_parameters')
        return {'status': 'reset', 'errors': []}

    # ── Setup checklist ─────────────────────────────────────────────────────
    @router.get('/setup')
    def setup_checklist() -> dict[str, Any]:
        steps: list[dict[str, Any]] = []
        blocked = pending = 0
        for s in spec.runtime.setup:
            entry = s.model_dump()
            variables = entry.get('variables') or []
            if variables:
                missing = [v for v in variables if not os.getenv(v)]
                entry['completed'] = not missing
                entry['missing_vars'] = missing
                if missing:
                    blocked += 1
            else:
                entry['completed'] = None
                entry['missing_vars'] = []
                pending += 1
            steps.append(entry)
        total = len(steps)
        return {
            'steps': steps,
            'total': total,
            'blocked_count': blocked,
            'pending_count': pending,
            'all_done': total > 0 and blocked == 0 and pending == 0,
        }

    # ── Agents & units (from the spec) ──────────────────────────────────────
    @router.get('/agents')
    def list_agents() -> list[dict[str, Any]]:
        return [_agent_summary(spec, agent) for agent in spec.ai.agents]

    @router.get('/agents/{agent_id}')
    def get_agent(agent_id: str) -> dict[str, Any]:
        for agent in spec.ai.agents:
            if agent.id == agent_id:
                return _agent_summary(spec, agent)
        raise HTTPException(status_code=404, detail=f'agent {agent_id!r} not found')

    @router.get('/units')
    def list_units() -> list[dict[str, Any]]:
        return [_unit_summary(spec, unit) for unit in spec.ai.units]

    @router.get('/workflows')
    def list_workflows() -> list[dict[str, Any]]:
        return [{'id': u.id, 'name': u.name} for u in spec.ai.units if u.model == 'pipeline']

    @router.post('/agents/{target_id}/enabled')
    async def set_enabled(target_id: str, body: Enabled) -> dict[str, Any]:
        if target_id not in targets:
            raise HTTPException(status_code=404, detail=f'{target_id!r} is not an agent or unit')
        await runtime.lifecycle.set_enabled(target_id, enabled=body.enabled, actor=body.actor)
        return {'id': target_id, 'enabled': body.enabled}

    # ── Streaming chat (SSE over the run transcript) ────────────────────────
    @router.post('/reasoners/{name}/stream')
    async def stream_reasoner(name: str, request: Request, user_id: str = Query(default='default')) -> EventSourceResponse:
        if name not in targets:
            raise HTTPException(status_code=404, detail=f'reasoner {name!r} not found')
        body = await request.json()
        started = await runtime.start_run(name, body.get('message', ''), body.get('session_id'), body.get('user_id', user_id))

        async def event_gen() -> Any:
            if started['status'] == 'refused':
                yield {'event': 'end', 'data': json.dumps({'status': 'refused', 'output': started['output']})}
                return
            yield {'event': 'started', 'data': json.dumps({'run_id': started['run_id']})}
            seen, status = 0, ''
            while True:
                run = await runtime.store.get_run(started['run_id'])
                if run is None:
                    return
                for event in run.transcript[seen:]:
                    yield {'event': event['type'], 'data': json.dumps(event, default=str)}
                seen = len(run.transcript)
                if run.status != status:
                    status = run.status
                    yield {'event': 'status', 'data': json.dumps({'status': status})}
                if run.status in TERMINAL:
                    yield {'event': 'end', 'data': json.dumps(_run_summary(run), default=str)}
                    return
                await asyncio.sleep(_STREAM_POLL_S)

        return EventSourceResponse(event_gen())

    # ── Runs ────────────────────────────────────────────────────────────────
    @router.get('/runs')
    async def list_runs(
        target: str | None = None,
        status: str | None = None,
        trigger_kind: str | None = None,
        since: datetime | None = None,
        until: datetime | None = None,
        limit: int = Query(default=100, ge=1, le=1000),
    ) -> list[dict[str, Any]]:
        runs = await runtime.store.list_runs(
            target=target, status=status, trigger_kind=trigger_kind, since=since, until=until, limit=limit
        )
        return [_run_summary(run) for run in runs]

    @router.get('/runs/{run_id}')
    async def get_run(run_id: str) -> dict[str, Any]:
        run = await runtime.store.get_run(run_id)
        if run is None:
            raise HTTPException(status_code=404, detail=f'run {run_id!r} not found')
        children = await runtime.store.list_runs(parent_id=run_id, limit=1000)
        return {**_run_summary(run), 'prompt': run.prompt, 'transcript': run.transcript, 'children': [_run_summary(c) for c in children]}

    @router.post('/runs/{run_id}/cancel')
    async def cancel_run(run_id: str) -> dict[str, Any]:
        if not await runtime.dispatcher.cancel(run_id):
            raise HTTPException(status_code=409, detail=f'run {run_id!r} is already finished')
        return {'id': run_id, 'status': 'cancelled'}

    # ── Approvals & inbox ───────────────────────────────────────────────────
    @router.get('/approvals')
    async def list_approvals(status: str | None = 'pending') -> list[dict[str, Any]]:
        approvals = await runtime.store.list_approvals(status=status)
        return [
            {
                'id': a.id,
                'run_id': a.run_id,
                'action_class': a.action_class,
                'tool_name': a.tool_name,
                'arguments': a.arguments,
                'approvers': a.approvers,
                'status': a.status,
                'created_at': a.created_at.isoformat(),
            }
            for a in approvals
        ]

    @router.post('/approvals/{approval_id}')
    async def decide_approval(approval_id: str, body: Decision) -> dict[str, Any]:
        decided = await runtime.approvals.decide(
            approval_id,
            approved=body.approved,
            actor=body.actor,
            comment=body.comment,
            edited_arguments=body.edited_arguments,
        )
        if not decided:
            raise HTTPException(status_code=409, detail=f'approval {approval_id!r} is not pending')
        return {'id': approval_id, 'status': 'approved' if body.approved else 'rejected'}

    @router.get('/inbox')
    async def list_inbox() -> list[dict[str, Any]]:
        return [
            {'id': i.id, 'kind': i.kind, 'run_id': i.run_id, 'reason': i.reason, 'context': i.context, 'created_at': i.created_at.isoformat()}
            for i in await runtime.store.list_inbox()
        ]

    # ── Lifecycle & health ──────────────────────────────────────────────────
    @router.get('/lifecycle')
    async def get_lifecycle() -> dict[str, Any]:
        history = await runtime.store.lifecycle_history()
        state = await runtime.lifecycle.state()
        return {
            'state': state,
            'reason': history[-1].reason if history else '',
            'history': [
                {'from': e.from_state, 'to': e.to_state, 'actor': e.actor, 'reason': e.reason, 'at': e.at.isoformat()}
                for e in history
            ],
        }

    @router.post('/lifecycle')
    async def request_transition(body: Transition) -> dict[str, Any]:
        if not await runtime.lifecycle.transition(body.to, body.actor, body.reason):  # type: ignore[arg-type]
            raise HTTPException(status_code=409, detail=f'cannot move to {body.to!r} from {await runtime.lifecycle.state()!r}')
        return {'state': body.to}

    @router.get('/health')
    async def health() -> dict[str, Any]:
        return {'broker': broker_health(runtime.broker), 'lifecycle': await runtime.lifecycle.state()}

    # ── Knowledge ───────────────────────────────────────────────────────────
    @router.get('/knowledge/search')
    async def kn_search(
        query: str = Query(..., min_length=1),
        types: list[str] = Query(default=[]),
        top_k: int = Query(default=15, ge=1, le=100),
    ) -> list[dict[str, Any]]:
        hits = await similarity_units(knowledge, getattr(app, 'embedder_model', None), query, list(types) or None, top_k)
        return [_document(u) for u in hits]

    @router.get('/knowledge/{type}/{name}')
    async def get_unit(type: str, name: str) -> dict[str, Any]:  # noqa: A002
        unit = await knowledge.get(f'{_KN_PREFIX}{type}:{name}')
        if unit is None:
            raise HTTPException(status_code=404, detail=f'{type}/{name} not found')
        return _document(unit)

    @router.get('/knowledge')
    async def list_knowledge(
        type: str = Query(default=''),  # noqa: A002
        agent_id: str = Query(default=''),
        limit: int = Query(default=0, ge=0),
    ) -> list[dict[str, Any]]:
        units = [
            u
            for u in await _all_units()
            if u.get('content') is not None
            and (not type or u.get('type') == type)
            and (not agent_id or (u.get('metadata') or {}).get('agent_id') == agent_id)
        ]
        units.sort(key=lambda u: u.get('updated_at', ''), reverse=True)
        if limit > 0:
            units = units[:limit]
        return [_document(u) for u in units]

    # ── Activity summary ────────────────────────────────────────────────────
    # One-sentence pulse across ALL agents, fed to the always-visible bottom strip in
    # the dashboard. Computed from recent knowledge units (each unit's metadata carries
    # `agent_id` and `agent_name`, set by the runtime when a reasoner writes knowledge).
    @router.get('/activity/summary')
    async def activity_summary() -> dict[str, Any]:
        units = [u for u in await _all_units() if u.get('content') is not None]
        units.sort(key=lambda u: u.get('updated_at', ''), reverse=True)
        if not units:
            return {'summary': 'No agent activity yet.', 'level': 'idle',
                    'count_recent': 0, 'latest_at': None}
        latest = units[0]
        meta = latest.get('metadata') or {}
        agent_name = meta.get('agent_name') or meta.get('agent_id') or 'An agent'
        title = latest.get('title') or latest.get('name') or 'an item'
        latest_at = latest.get('updated_at') or latest.get('created_at')
        # Count activity in the last hour for the level + headline alternation.
        try:
            now = datetime.now(tz=UTC)
            recent = [
                u for u in units
                if datetime.fromisoformat(u['updated_at'].replace('Z', '+00:00')) >= now.replace(minute=now.minute, second=0, microsecond=0)
            ]
        except Exception:
            recent = units[:5]
        count_recent = len(recent)
        if count_recent >= 6:
            level = 'busy'
            summary = f'{count_recent} actions in the last hour - {agent_name} most recent.'
        elif count_recent >= 2:
            level = 'active'
            summary = f'{agent_name} just updated "{title}" (+{count_recent - 1} more recent).'
        else:
            level = 'active'
            summary = f'{agent_name} just updated "{title}".'
        return {'summary': summary, 'level': level, 'count_recent': count_recent, 'latest_at': latest_at}

    # ── Live knowledge events ───────────────────────────────────────────────
    # One in-process queue per WebSocket; AgentField's `on_change` fans events out to all of them.
    subscribers: set[asyncio.Queue[dict[str, Any]]] = set()

    async def _broadcast(event: Any) -> None:
        key = getattr(event, 'key', '') or ''
        msg = {
            'action': getattr(event, 'action', None),
            'key': key,
            'type': _type_of(key),
            'name': _name_of(key),
            'timestamp': getattr(event, 'timestamp', None),
        }
        for q in list(subscribers):
            with contextlib.suppress(asyncio.QueueFull):
                q.put_nowait(msg)

    # `on_change` opens a websocket to the control plane, so it needs a running event loop —
    # register on FastAPI startup, not at import time.
    async def _wire_kn_events() -> None:
        knowledge.on_change('kn:*')(_broadcast)

    app.router.add_event_handler('startup', _wire_kn_events)

    @router.websocket('/knowledge/events')
    async def kn_events(ws: WebSocket) -> None:
        await ws.accept()
        q: asyncio.Queue[dict[str, Any]] = asyncio.Queue(maxsize=256)
        subscribers.add(q)
        try:
            while True:
                msg = await q.get()
                await ws.send_json(msg)
        except WebSocketDisconnect:
            pass
        finally:
            subscribers.discard(q)

    return router


_KN_KEY_PARTS = 3


def _type_of(key: str) -> str | None:
    parts = key.split(':', 2)
    return parts[1] if len(parts) >= _KN_KEY_PARTS and parts[0] == 'kn' else None


def _name_of(key: str) -> str | None:
    parts = key.split(':', 2)
    return parts[2] if len(parts) >= _KN_KEY_PARTS and parts[0] == 'kn' else None


