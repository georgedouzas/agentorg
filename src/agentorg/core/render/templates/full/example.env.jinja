# Required
{% for v in runtime.env_vars.required %}{{ v.name }}=
{% endfor %}

# Optional
{% for v in runtime.env_vars.optional %}{{ v.name }}=
{% endfor %}

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=ai
DB_PASS=ai
DB_DATABASE=ai

# LibreChat, the org's chat app. It shares CHAT_API_KEY above with the API. Generate the hex secrets with
# `openssl rand -hex 32` (CREDS_KEY, JWT secrets, MEILI_MASTER_KEY) and `openssl rand -hex 16` (CREDS_IV).
CONSOLE_URL=http://localhost:5173
LIBRECHAT_URL=http://localhost:3080
LIBRECHAT_ALLOW_REGISTRATION=true
LIBRECHAT_CREDS_KEY=
LIBRECHAT_CREDS_IV=
LIBRECHAT_JWT_SECRET=
LIBRECHAT_JWT_REFRESH_SECRET=
MEILI_MASTER_KEY=
