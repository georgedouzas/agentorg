"""Smoke-test every agent of the spec on the Claude agent harness, without a broker.

Run with:
    uv run python -m {{ org.package_name }}.sandbox
"""

import asyncio
import os
import tempfile
from pathlib import Path

from agentorg.core.operations import OrgRuntime

from {{ org.package_name }}.spec import spec

SMOKE_PROMPT = 'Hello, please reply with one short sentence so I can confirm you are reachable.'


async def main() -> None:
    """Run each agent once on the smoke prompt in preview mode and print its output and cost."""
    environ = {**os.environ, 'AGENTORG_PREVIEW_MODE': 'true'}
    data_dir = Path(tempfile.mkdtemp(prefix='{{ org.slug }}-sandbox-'))
    runtime = OrgRuntime(spec, environ=environ, data_dir=data_dir, skills_dir=Path(__file__).parent / 'skills')
    await runtime.start()
    try:
        for agent in spec.ai.agents:
            result = await runtime.run_target(agent.id, SMOKE_PROMPT, None, 'sandbox')
            run = await runtime.store.get_run(result['run_id']) if 'run_id' in result else None
            cost = f'{run.cost_usd:.4f} USD' if run else 'n/a'
            print(f'[{agent.id}] {result["status"]} ({cost}): {result["output"]}')
    finally:
        await runtime.stop()


if __name__ == '__main__':
    asyncio.run(main())
