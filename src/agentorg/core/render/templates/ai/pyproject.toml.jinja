[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "{{ org.package_name }}"
version = "1.0.0"
description = "{{ org.description }}"
requires-python = ">=3.12, <3.14"
dependencies = [
    "agentorg",
    "agentfield>=0.1.84",
]

[dependency-groups]
dev = ["pytest>=8", "pytest-asyncio>=0.23"]

[tool.hatch.build.targets.wheel]
packages = ["src/{{ org.package_name }}"]

[tool.agentorg.test-layout]
exempt = ["src/{{ org.package_name }}/cli.py", "src/{{ org.package_name }}/sandbox.py"]

[tool.pytest.ini_options]
asyncio_mode = "auto"
