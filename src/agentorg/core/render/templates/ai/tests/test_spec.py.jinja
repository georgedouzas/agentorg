"""Tests that the spec's agents and units register on the node as tagged reasoners."""

from typing import Any

from agentfield import Agent

from agentorg.core.adapters.claude import register_org

from {{ org.package_name }}.spec import spec


async def _run_target(target: str, message: str, session_id: str | None, user_id: str) -> dict[str, Any]:
    return {'status': 'succeeded', 'output': target}


def test_register_org_registers_every_agent_and_unit() -> None:
    """Every agent and every unit of the spec becomes a reasoner, agents first."""
    names = register_org(Agent(node_id=spec.org.slug), spec, _run_target)
    assert names == [agent.id for agent in spec.ai.agents] + [unit.id for unit in spec.ai.units]


def test_registered_reasoners_carry_org_tag() -> None:
    """Every reasoner carries the org slug, so control-plane policies can target the org."""
    node = Agent(node_id=spec.org.slug)
    register_org(node, spec, _run_target)
    assert all(spec.org.slug in reasoner['tags'] for reasoner in node.reasoners)
