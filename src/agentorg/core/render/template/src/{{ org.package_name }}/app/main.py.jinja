"""Entry point — boots the org as an AgentField node.

The org is one AgentField `Agent` node (`node_id = org slug`). The spec's agents, teams, and workflows are
registered as reasoners on it. The node is a FastAPI app, so it runs standalone with `uvicorn` for local dev, and
registers with the control plane when `AGENTFIELD_SERVER` is set.
"""

import os

from agentfield import Agent
from fastapi.middleware.cors import CORSMiddleware

from agentorg.core.adapters.agno import register_agents, register_teams, register_workflows
from agentorg.core.agents.agno.platform import register_platform_agents

from {{ org.package_name }}.app.routes import build_router
from {{ org.package_name }}.spec import spec

os.environ.setdefault('AGENTORG_ORG_SLUG', spec.org.slug)

_server = os.getenv('AGENTFIELD_SERVER')
_has_server = _server is not None

# With a control plane, register and enable identity/credentials. Standalone (local dev, tests), the node still
# serves every reasoner over HTTP — it just skips the control-plane handshake.
app = Agent(
    node_id=spec.org.slug,
    version='1.0.0',
    description=spec.org.description,
    tags=[spec.org.slug],
    agentfield_server=_server,
    api_key=os.getenv('AGENTFIELD_API_KEY'),
    auto_register=_has_server,
    enable_did=_has_server,
    vc_enabled=_has_server,
    dev_mode=not _has_server,
)

# Embedder declared in `spec.runtime.infra.embedder` — stashed on the node so the knowledge tools resolve it.
app.embedder_model = spec.runtime.infra.embedder  # type: ignore[attr-defined]

# The spec's agents/teams/workflows become reasoners on this node. Each agent's tools are
# also exposed as AgentField skills (registered inside `register_reasoner`) so the control
# plane can policy-gate them and the MCP shim can re-publish them.
# Substitute principles parameter defaults into section bodies so agents see `Applied Research`
# rather than the literal `{domain_focus}` placeholder, and wrap each principles section in a
# `### {title}` sub-heading so the appended `## Principles` block stays readable.
class _SafeDefaults(dict):
    def __missing__(self, key: str) -> str:
        return '{' + key + '}'

_param_defaults = _SafeDefaults({p.name: p.default for p in spec.knowledge.principles.parameters})
_principles_text = '\n\n'.join(
    f'### {s.title}\n\n{s.body.format_map(_param_defaults).strip()}'
    for s in spec.knowledge.principles.sections
)
register_platform_agents(app, _principles_text)
register_agents(app, spec, _principles_text)
register_teams(app, spec)
register_workflows(app, spec)

_origins = [o.strip() for o in os.getenv('ALLOWED_ORIGINS', '*').split(',') if o.strip()]
app.add_middleware(
    CORSMiddleware,
    allow_origins=_origins,
    allow_credentials=True,
    allow_methods=['*'],
    allow_headers=['*'],
)

app.include_router(build_router(app, spec))


if __name__ == '__main__':
    app.serve(port=int(os.getenv('PORT', '8000')), dev=os.getenv('RUNTIME_ENV', '') == 'dev')
