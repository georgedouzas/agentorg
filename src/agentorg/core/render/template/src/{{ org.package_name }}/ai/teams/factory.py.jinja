"""Team factory — builds teams from the spec.

Architecture: `{{ team_architecture if team_architecture is not none else 'none' }}`.
"""

{% if team_architecture %}
from agno.agent import Agent as AgnoAgent
from agno.team import Team

from agentorg.core.schema import Spec

_MODE = '{{ team_architecture }}'


def build_teams(spec: Spec, agents: dict[str, AgnoAgent]) -> list[Team]:
    """Return one `Team` per spec entry, in `{{ team_architecture }}` mode."""
    teams: list[Team] = []
    for team_spec in spec.generated.teams:
        leader = agents[team_spec.leader]
        members = [agents[m] for m in team_spec.members]
        teams.append(
            Team(
                id=team_spec.id,
                name=team_spec.name,
                description=team_spec.description,
                mode=_MODE,
                model=leader.model,
                members=members,
            ),
        )
    return teams
{% else %}
from typing import Any

from agentorg.core.schema import Spec


def build_teams(spec: Spec, agents: dict[str, Any]) -> list[Any]:
    """No teams configured for this org (team_architecture is null)."""
    return []
{% endif %}
