"""AgentOS entry point — registers agents, teams, workflows, and mounts the API router."""

import os
from pathlib import Path

from agno.os import AgentOS
from fastapi.middleware.cors import CORSMiddleware
from fastapi.staticfiles import StaticFiles

from {{ org.package_name }}.ai.agents.factory import build_agents
from {{ org.package_name }}.ai.teams.factory import build_teams
from {{ org.package_name }}.ai.workflows.factory import build_workflows
from {{ org.package_name }}.app.routes import router
from {{ org.package_name }}.db import create_app_tables, get_postgres_db, truncate_user_data
from {{ org.package_name }}.org import seed_policy_documents
from {{ org.package_name }}.org.platform_kb import seed_platform_kb

# Ensure tables exist
create_app_tables()

# Dev convenience: wipe all user-created data on every restart so the app boots fresh.
# Set RESET_ON_STARTUP=1 in compose.yaml; do NOT enable in production.
if os.getenv("RESET_ON_STARTUP", "").strip() == "1":
    truncate_user_data()

# Seed reference docs (platform + policies) — idempotent
seed_platform_kb()
seed_policy_documents()

# ---------------------------------------------------------------------------
# Create AgentOS
# ---------------------------------------------------------------------------
agents = list(build_agents().values())
teams = build_teams()
workflows = build_workflows()

agent_os = AgentOS(
    name="{{ org.name }}",
    tracing=True,
    scheduler=True,
    db=get_postgres_db(),
    agents=agents,
    teams=teams,
    workflows=workflows,
    config=str(Path(__file__).parent / "config.yaml"),
)

app = agent_os.get_app()

# Allow the Vercel-hosted dashboard to call this API cross-origin.
# Set ALLOWED_ORIGINS to a comma-separated list of allowed origins in production.
_origins = [o.strip() for o in os.getenv("ALLOWED_ORIGINS", "*").split(",") if o.strip()]
app.add_middleware(
    CORSMiddleware,
    allow_origins=_origins,
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

app.include_router(router)


# Serve Vite-built static assets (JS/CSS bundles) if the public/assets dir exists.
_assets_dir = Path(__file__).parent.parent.parent.parent / "public" / "assets"
if _assets_dir.exists():
    app.mount("/assets", StaticFiles(directory=str(_assets_dir)), name="assets")

if __name__ == "__main__":
    port = int(os.getenv("PORT", "8000"))
    reload = os.getenv("RUNTIME_ENV", "") == "dev"
    agent_os.serve(app="app.main:app", port=port, reload=reload)
