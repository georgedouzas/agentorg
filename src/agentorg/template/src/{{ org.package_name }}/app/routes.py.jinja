# ── State endpoints (generic) ────────────────────────────────────────────────
@router.get("/state")
def get_state(user_id: str = Query(default="default")) -> dict[str, Any]:
    """Return the org state for a user."""
    with get_engine().connect() as conn:
        row = conn.execute(
            text("SELECT parameters, data FROM org_state WHERE user_id = :uid"),
            {"uid": user_id},
        ).first()
    if row is None:
        return {"configured": False, "parameters": {}, "data": {}}
    return {"configured": True, "parameters": row.parameters or {}, "data": row.data or {}}


@router.post("/setup")
def setup_state(body: OrgConfig, user_id: str = Query(default="default")) -> dict[str, Any]:  # type: ignore[valid-type]
    """First-run / post-reset setup: write the user's charter parameters and (re-)seed the
    policy document so it reflects the just-submitted values.
    """
    params = {**body.model_dump(), "inception_date": datetime.now(tz=UTC).date().isoformat()}
    with get_engine().begin() as conn:
        conn.execute(
            text("""
                INSERT INTO org_state (user_id, parameters, data)
                VALUES (:uid, CAST(:p AS JSONB), '{}')
                ON CONFLICT (user_id) DO UPDATE
                    SET parameters = EXCLUDED.parameters,
                        updated_at = NOW()
            """),
            {"uid": user_id, "p": json.dumps(params)},
        )
    from {{ org.package_name }}.org import seed_policy_documents  # noqa: PLC0415

    seed_policy_documents(user_id)
    return {"status": "configured", "parameters": params}


@router.post("/reset")
def reset_state(user_id: str = Query(default="default")) -> dict[str, Any]:
    """Wipe documents, learnings, agent history, and the org_state row for this user.
    Frontend re-fetches /api/state afterwards and is sent through the setup flow again.
    """
    errors: list[str] = []

    try:
        with get_engine().begin() as conn:
            conn.execute(text("TRUNCATE TABLE knowledge RESTART IDENTITY CASCADE"))
            conn.execute(text("DELETE FROM org_state WHERE user_id = :uid"), {"uid": user_id})
        # Re-seed platform reference docs (param-independent). Policy docs are re-seeded
        # by /api/setup once the user has submitted their parameters.
        from {{ org.package_name }}.org.platform_kb import seed_platform_kb  # noqa: PLC0415

        seed_platform_kb()
    except SQLAlchemyError as e:
        errors.append(f"app_tables: {e}")

    try:
        from {{ org.package_name }}.ai.agents.settings import team_knowledge, team_learnings  # noqa: PLC0415

        for kb in [team_knowledge, team_learnings]:
            if kb.vector_db:
                kb.vector_db.drop()
                kb.vector_db.create()
    except Exception as e:  # noqa: BLE001
        errors.append(f"vector_db: {e}")

    try:
        with get_engine().begin() as conn:
            for table in TRUNCATE_AGNO_TABLES:
                try:
                    conn.execute(text(f"TRUNCATE TABLE {table} RESTART IDENTITY CASCADE"))
                except SQLAlchemyError as e:
                    errors.append(f"{table}: {e}")
    except SQLAlchemyError as e:
        errors.append(f"agno_tables: {e}")

    return {"status": "reset", "errors": errors}


# ── Documents endpoints ──────────────────────────────────────────────────────
@router.get("/documents")
def list_documents(type: str = Query(default=""), ticker: str = Query(default="")) -> list[dict[str, Any]]:  # noqa: A002
    """List documents (content-bearing knowledge rows). Excludes feed rows that back
    Overview widgets — those are infrastructure, not documents."""
    sql = "SELECT type, name, content, metadata, created_at FROM knowledge WHERE content IS NOT NULL"
    conds: list[str] = []
    params: dict[str, Any] = {}
    if type:
        conds.append("type = :t")
        params["t"] = type
    if ticker:
        conds.append("metadata @> CAST(:m AS JSONB)")
        params["m"] = json.dumps({"ticker": ticker.upper()})
    if conds:
        sql += " AND " + " AND ".join(conds)
    sql += " ORDER BY created_at DESC"
    try:
        with get_engine().connect() as conn:
            rows = conn.execute(text(sql), params).fetchall()
    except SQLAlchemyError:
        return []
    return [
        {
            "type": r.type,
            "name": r.name,
            "content": r.content,
            "metadata": r.metadata or {},
            "created_at": r.created_at.isoformat() if r.created_at else None,
        }
        for r in rows
    ]


@router.get("/documents/search")
def search_docs(query: str = Query(..., min_length=1), types: list[str] = Query(default=[])) -> list[dict[str, Any]]:
    """Full-text search across document content."""
    sql = (
        "SELECT type, name, content, metadata,"
        " ts_rank(to_tsvector('english', content || ' ' || name),"
        "         plainto_tsquery('english', :q)) AS score"
        " FROM knowledge"
        " WHERE to_tsvector('english', content || ' ' || name)"
        " @@ plainto_tsquery('english', :q)"
    )
    params: dict[str, Any] = {"q": query}
    if types:
        sql += " AND type = ANY(CAST(:types AS TEXT[]))"
        params["types"] = types
    sql += " ORDER BY score DESC LIMIT 15"
    with get_engine().connect() as conn:
        rows = conn.execute(text(sql), params).fetchall()
    return [
        {
            "type": r.type,
            "name": r.name,
            "content": r.content,
            "metadata": r.metadata or {},
            "score": float(r.score),
        }
        for r in rows
    ]


@router.get("/document/{type}/{name}")
def get_document(type: str, name: str) -> dict[str, Any]:  # noqa: A002
    """Fetch a single document by type and name."""
    with get_engine().connect() as conn:
        row = conn.execute(
            text("SELECT content, metadata, created_at FROM knowledge WHERE type = :t AND name = :n"),
            {"t": type, "n": name},
        ).first()
    if row is None:
        raise HTTPException(status_code=404, detail=f"{type}/{name} not found")
    return {
        "type": type,
        "name": name,
        "content": row.content,
        "metadata": row.metadata or {},
        "created_at": row.created_at.isoformat(),
    }


# ── Feeds: featured knowledge rows for the Overview tab ──────────────────────
@router.get("/feeds")
def list_feeds() -> list[dict[str, Any]]:
    """Return featured knowledge rows for the Overview, ordered by display.order."""
    sql = (
        "SELECT type, name, title, display, metadata, last_computed"
        " FROM knowledge"
        " WHERE display @> CAST(:f AS JSONB)"
        " ORDER BY (display->>'order')::int NULLS LAST, name"
    )
    with get_engine().connect() as conn:
        rows = conn.execute(text(sql), {"f": json.dumps({"featured": True})}).fetchall()
    return [
        {
            "type": r.type,
            "name": r.name,
            "title": r.title,
            "display": r.display or {},
            "metadata": r.metadata or {},
            "last_computed": r.last_computed.isoformat() if r.last_computed else None,
        }
        for r in rows
    ]


# ── Live data endpoint for refreshable knowledge ─────────────────────────────
@router.get("/knowledge/{type}/{name}/data")
def knowledge_data(
    type: str,  # noqa: A002
    name: str,
    user_id: str = Query(default="default"),
) -> dict[str, Any]:
    """Return the current `data` for a knowledge row. For `on_request` schedules, runs
    the provider live before responding so callers always see fresh data. The `user_id`
    query param is merged into the provider's call args so per-user feeds resolve
    against the calling user's state."""
    with get_engine().connect() as conn:
        row = conn.execute(
            text(
                "SELECT data, schedule, last_computed, last_error"
                " FROM knowledge WHERE type = :t AND name = :n",
            ),
            {"t": type, "n": name},
        ).first()
    if row is None:
        raise HTTPException(status_code=404, detail=f"{type}/{name} not found")

    if row.schedule == "on_request":
        from {{ org.package_name }}.ai.refresh import refresh_knowledge_row  # noqa: PLC0415

        refresh_knowledge_row(name, extra_args={"user_id": user_id})
        with get_engine().connect() as conn:
            row = conn.execute(
                text(
                    "SELECT data, last_computed, last_error"
                    " FROM knowledge WHERE type = :t AND name = :n",
                ),
                {"t": type, "n": name},
            ).first()

    return {
        "data": row.data,
        "last_computed": row.last_computed.isoformat() if row.last_computed else None,
        "last_error": row.last_error,
    }


