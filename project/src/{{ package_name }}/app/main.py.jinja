"""AgentOS entry point — registers all agents, workflows, and mounts the API router."""

import os
from pathlib import Path

from agno.os import AgentOS
from fastapi.middleware.cors import CORSMiddleware
from fastapi.staticfiles import StaticFiles

{% for agent in generated.agents | sort(attribute='id') %}
from {{ package_name }}.ai.agents.{{ agent.id | replace('-', '_') }} import {{ agent.id | replace('-', '_') }}
{% endfor %}
from {{ package_name }}.ai.refresh import start_scheduler
from {{ package_name }}.ai.tools.providers import import_universal_providers
{% for wf in generated.workflows %}
from {{ package_name }}.ai.workflows.{{ wf.id | replace('-', '_') }} import {{ wf.id | replace('-', '_') }}
{% endfor %}
from {{ package_name }}.app.routes import router
from {{ package_name }}.db import create_app_tables, get_postgres_db, truncate_user_data
from {{ package_name }}.org import bootstrap_overview_feeds, seed_policy_documents
from {{ package_name }}.org.platform_kb import seed_platform_kb

# Ensure tables exist
create_app_tables()

# Dev convenience: wipe all user-created data on every restart so the app boots fresh.
# Set RESET_ON_STARTUP=1 in compose.yaml; do NOT enable in production.
if os.getenv("RESET_ON_STARTUP", "").strip() == "1":
    truncate_user_data()

# Seed reference docs (platform + policies + overview feeds) — idempotent
seed_platform_kb()
seed_policy_documents()
bootstrap_overview_feeds()

# Register universal refresh providers (yfinance, state, knowledge)
import_universal_providers()

# ---------------------------------------------------------------------------
# Create AgentOS
# ---------------------------------------------------------------------------
agent_os = AgentOS(
    name="{{ org.name }}",
    tracing=True,
    scheduler=True,
    db=get_postgres_db(),
    agents=[
{% for agent in generated.agents %}
        {{ agent.id | replace('-', '_') }},
{% endfor %}
    ],
    teams=[],
    workflows=[{% for wf in generated.workflows %}{{ wf.id | replace('-', '_') }}{% if not loop.last %}, {% endif %}{% endfor %}],
    config=str(Path(__file__).parent / "config.yaml"),
)

app = agent_os.get_app()

# Allow the Vercel-hosted dashboard to call this API cross-origin.
# Set ALLOWED_ORIGINS to a comma-separated list of allowed origins in production.
_origins = [o.strip() for o in os.getenv("ALLOWED_ORIGINS", "*").split(",") if o.strip()]
app.add_middleware(
    CORSMiddleware,
    allow_origins=_origins,
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

app.include_router(router)


@app.on_event("startup")
async def _start_knowledge_scheduler() -> None:
    """Boot the refresh scheduler once the FastAPI event loop is running."""
    start_scheduler()

# Serve Vite-built static assets (JS/CSS bundles) if the public/assets dir exists.
_assets_dir = Path(__file__).parent.parent.parent.parent / "public" / "assets"
if _assets_dir.exists():
    app.mount("/assets", StaticFiles(directory=str(_assets_dir)), name="assets")

if __name__ == "__main__":
    port = int(os.getenv("PORT", "8000"))
    reload = os.getenv("RUNTIME_ENV", "") == "dev"
    agent_os.serve(app="app.main:app", port=port, reload=reload)
