"""Platform reference docs — seeded into the knowledge table on app startup."""

from pathlib import Path

KB_DIR = Path(__file__).parent


def seed_platform_kb() -> None:
    """Upsert each markdown file in this dir as a `platform_reference` knowledge unit.

    Always re-seeds (write_knowledge upserts on conflict) so metadata stays in sync if
    the agentorg framework updates the KB content.
    """
    from {{ package_name }}.ai.tools.knowledge import write_knowledge  # noqa: PLC0415

    for md in sorted(KB_DIR.glob("*.md")):
        write_knowledge(
            type="platform_reference",
            name=md.stem,
            title=md.stem.title(),
            content=md.read_text(),
            metadata={"platform": md.stem, "agent_id": "platform-engineer", "source": "agentorg-platform-kb"},
        )
