  "setup": {
    "steps": [
      {
        "id": "secrets",
        "title": "Set required API keys in .env",
        "vars": [
          "GOOGLE_API_KEY",
          "GITHUB_TOKEN"
        ]
      },
      {
        "id": "github_repo",
        "title": "Create GitHub repo & push",
        "platform": "github",
        "command": "gh repo create {{ org_slug }} --private --source=. --push"
      },
      {
        "id": "railway",
        "title": "Deploy API + DB to Railway",
        "platform": "railway",
        "command": "railway login && nox -s deploy"
      }
    ]
  }
