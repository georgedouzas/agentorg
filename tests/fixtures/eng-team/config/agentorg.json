    "teams": [
      {
        "id": "build-team",
        "name": "Build Team",
        "description": "The hands-on implementation squad \u2014 translates a design into working code across backend and frontend, with the tech lead steering scope and trade-offs.",
        "leader": "tech-lead",
        "members": [
          "backend-engineer",
          "frontend-engineer"
        ]
      },
      {
        "id": "ship-team",
        "name": "Ship Team",
        "description": "Owns everything past code-complete: verification, release-readiness, and rollout. The QA engineer steers; the platform engineer handles deployment mechanics.",
        "leader": "qa-engineer",
        "members": [
          "platform-engineer"
        ]
      }
    ],
    "workflows": [
      {
        "id": "engineering-workflow",
        "name": "Engineering Pipeline",
        "description": "Deterministic pipeline: plan \u2192 design \u2192 implement (parallel) \u2192 test \u2192 ship",
        "steps": [
          {
            "name": "Plan",
            "agent": "product-manager",
            "hitl": {
              "type": "output_review",
              "message": "Review the proposed user stories. Approve to proceed to design.",
              "on_reject": "cancel"
            }
          },
          {
            "name": "Design",
            "agent": "architect"
          },
          {
            "name": "Implement",
            "parallel": [
              {
                "name": "Backend",
                "agent": "backend-engineer"
              },
              {
                "name": "Frontend",
                "agent": "frontend-engineer"
              }
            ]
          },
          {
            "name": "Test",
            "agent": "qa-engineer",
            "hitl": {
              "type": "output_review",
              "message": "Review test results. Approve to proceed to ship.",
              "on_reject": "cancel"
            }
          },
          {
            "name": "Ship",
            "agent": "tech-lead"
          }
        ]
      }
    ],
    "tools": [
      "ai/tools/documents.py",
      "ai/tools/setup.py",
      "ai/tools/state.py",
      "ai/tools/codebase.py",
      "ai/tools/github.py",
      "ai/tools/reports.py"
